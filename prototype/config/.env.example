# KADSAMHSA LMS — local environment (copy to repo root as .env)
# cp config/.env.example .env
# Never commit .env

# --- Moodle ---
MOODLE_URL=http://localhost:8080
MOODLE_SITE_FULLNAME="KADSAMHSA LMS"
MOODLE_SITE_SHORTNAME=KADSAMHSA
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS="ChangeMe_Admin_LocalOnly!"
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_LANG=en

# Paths inside containers (do not change unless you change compose mounts)
MOODLE_WWWROOT=http://localhost:8080
MOODLE_DATAROOT=/var/www/moodledata

# --- MariaDB ---
MYSQL_ROOT_PASSWORD="ChangeMe_Root_LocalOnly!"
MYSQL_DATABASE=moodle
MYSQL_USER=moodle
MYSQL_PASSWORD="ChangeMe_Moodle_LocalOnly!"
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Mailpit (local SMTP capture — no real outbound mail) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=none
MAILPIT_UI_URL=http://localhost:8025

# --- Paystack (placeholders — wire test keys in Phase 3) ---
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_MODE=test

# --- Docker publish ports ---
MOODLE_HTTP_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
