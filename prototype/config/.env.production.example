# KADSAMHSA LMS — PRODUCTION environment
#
#   cp config/.env.production.example .env.production
#   chmod 600 .env.production
#
# NEVER commit .env.production. Generate every secret below with:
#   openssl rand -base64 32

# --- Public site ---
# Bare domain or subdomain that already points an A record at this server.
MOODLE_DOMAIN=lms.kadsamhsa.example
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=it@kadsamhsa.example

MOODLE_URL=https://lms.kadsamhsa.example
MOODLE_WWWROOT=https://lms.kadsamhsa.example
MOODLE_DATAROOT=/var/www/moodledata

MOODLE_SITE_FULLNAME="KADSAMHSA LMS"
MOODLE_SITE_SHORTNAME=KADSAMHSA
MOODLE_LANG=en

# --- Admin account (created once at install) ---
MOODLE_ADMIN_USER=kadsadmin
MOODLE_ADMIN_PASS="CHANGE_ME_generate_with_openssl_rand"
MOODLE_ADMIN_EMAIL=it@kadsamhsa.example

# --- MariaDB (never exposed outside the Docker network) ---
MYSQL_ROOT_PASSWORD="CHANGE_ME_generate_with_openssl_rand"
MYSQL_DATABASE=moodle
MYSQL_USER=moodle
MYSQL_PASSWORD="CHANGE_ME_generate_with_openssl_rand"
MYSQL_HOST=db
MYSQL_PORT=3306

# Tune to roughly 50% of server RAM for a DB-heavy box, 25% for a shared box.
DB_BUFFER_POOL_SIZE=1G
DB_MAX_CONNECTIONS=200

# --- Real outbound SMTP (no Mailpit in production) ---
# Examples: smtp.sendgrid.net:587 (user "apikey"), smtp.eu.mailgun.org:587,
#           email-smtp.eu-west-1.amazonaws.com:587 (Amazon SES)
SMTP_HOST=smtp.example-provider.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS="CHANGE_ME_smtp_password_or_api_key"
# tls = STARTTLS on 587 (recommended) | ssl = implicit TLS on 465 | none
SMTP_SECURITY=tls
MOODLE_NOREPLY_ADDRESS=no-reply@kadsamhsa.example
MOODLE_SUPPORT_EMAIL=support@kadsamhsa.example

# --- Paystack (LIVE keys — Phase 3) ---
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_MODE=live

# --- Behaviour flags ---
# email = learners can self-register; none = admin/manual enrolment only
MOODLE_REGISTERAUTH=email
# 0 = site front page, 1 = /my/ dashboard
MOODLE_DEFAULT_HOMEPAGE=0

# --- Backups ---
BACKUP_DIR=/opt/kadsamhsa/backups
BACKUP_RETENTION_DAYS=14
