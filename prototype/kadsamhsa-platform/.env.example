# Copy to .env for local development. Never commit the filled-in file.

# ---- API ----
NODE_ENV=development
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:5180

# ---- Database ----
DATABASE_URL=postgres://kadsamhsa:kadsamhsa@localhost:5433/kadsamhsa

# ---- Redis (jobs, rate limiting) ----
REDIS_URL=redis://localhost:6380

# ---- Auth ----
# 32+ random bytes, base64. Generate: openssl rand -base64 48
ACCESS_TOKEN_SECRET=change-me-in-every-environment-0000000000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ---- Email (Mailpit locally, real relay in production) ----
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="KADSAMHSA Academy <no-reply@kadsamhsa.org>"

# ---- Payments (server-side only — never exposed to the browser) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---- Object storage ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
