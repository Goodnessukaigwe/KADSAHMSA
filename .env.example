# Publishable — these are sent to the browser. Never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Server-only — used by Route Handlers, Server Actions, and jobs.
# Do not prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
RESEND_API_KEY=

# Auth (Supabase dashboard — required for forgot-password mail)
# Authentication → Providers → Email: Confirm email OFF (signup does not verify email)
# Site URL: http://localhost:3000
# Redirect URLs: http://localhost:3000/auth/callback and http://localhost:3000/auth/confirm
# (add the same paths for staging/production)
# Reset password template (token-hash; /auth/confirm already handles it):
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/reset-password
# Org CSV enrol and scripts/import-dptc-course.ts still auto-confirm provisioned accounts.
