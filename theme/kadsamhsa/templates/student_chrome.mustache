{{!
    @template theme_kadsamhsa/student_chrome

    Shared logged-in top bar + sidebar (Figma student app chrome).
    Expects: sitename, logourl, firstname, userpicture, homeurl, dashboardurl, coursesurl,
    quizurl, logouturl, navhome, navcourses, navquiz
}}
<a href="{{{dashboardurl}}}" class="kadsamhsa-shome-brand" aria-label="{{{sitename}}}">
    {{#logourl}}
        <img src="{{{logourl}}}" alt="KADSAMHSA" class="kadsamhsa-shome-brand__logo" width="40" height="30" />
    {{/logourl}}
    <span class="kadsamhsa-shome-brand__text">KADSAMHSA</span>
</a>

<header class="kadsamhsa-shome-top" role="banner">
    <div class="kadsamhsa-shome-top__tools">
        <form class="kadsamhsa-shome-search" action="{{{coursesurl}}}" method="get" role="search">
            <label for="kadsamhsa-shome-search" class="sr-only">{{#str}}dashsearchlabel, theme_kadsamhsa{{/str}}</label>
            <span class="kadsamhsa-shome-search__icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </span>
            <input
                type="search"
                id="kadsamhsa-shome-search"
                name="q"
                class="kadsamhsa-shome-search__input"
                placeholder="{{#str}}dashsearchplaceholder, theme_kadsamhsa{{/str}}"
                data-action="dash-search"
                autocomplete="off"
            />
        </form>
        <button type="button" class="kadsamhsa-shome-top__iconbtn" data-action="theme-toggle" aria-label="{{#str}}dashthemetoggle, theme_kadsamhsa{{/str}}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
</header>

<aside class="kadsamhsa-shome-side" aria-label="{{#str}}dashnavlabel, theme_kadsamhsa{{/str}}">
    <div class="kadsamhsa-shome-side__panel">
        <div class="kadsamhsa-shome-side__user">
            <div class="kadsamhsa-shome-side__avatar">
                {{#userpicture}}
                    {{{userpicture}}}
                {{/userpicture}}
                {{^userpicture}}
                    <span class="kadsamhsa-shome-side__avatar-ph" aria-hidden="true"></span>
                {{/userpicture}}
            </div>
            <div class="kadsamhsa-shome-side__meta">
                <div class="kadsamhsa-shome-side__name">{{firstname}}</div>
                <a href="{{{logouturl}}}" class="kadsamhsa-shome-side__logout">{{#str}}dashlogout, theme_kadsamhsa{{/str}}</a>
            </div>
        </div>

        <nav class="kadsamhsa-shome-side__nav">
            <a href="{{{dashboardurl}}}" class="kadsamhsa-shome-side__link{{#navhome}} is-active{{/navhome}}">
                <span class="kadsamhsa-shome-side__ico" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 10.5L12 4l8 6.5V20a1 1 0 01-1 1h-5v-6H10v6H5a1 1 0 01-1-1v-9.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                </span>
                <span>{{#str}}dashnavhome, theme_kadsamhsa{{/str}}</span>
            </a>
            <a href="{{{coursesurl}}}" class="kadsamhsa-shome-side__link{{#navcourses}} is-active{{/navcourses}}">
                <span class="kadsamhsa-shome-side__ico" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M10 9.5v4l3.5-2L10 9.5z" fill="currentColor"/><path d="M8 19h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </span>
                <span>{{#str}}dashnavcourses, theme_kadsamhsa{{/str}}</span>
            </a>
            <a href="{{{quizurl}}}" class="kadsamhsa-shome-side__link{{#navquiz}} is-active{{/navquiz}}">
                <span class="kadsamhsa-shome-side__ico" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 9.5l8-4 8 4-8 4-8-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M7 11.5v4.2c0 .8 2.2 2.3 5 2.3s5-1.5 5-2.3V11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M20 10.5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </span>
                <span>{{#str}}dashnavquiz, theme_kadsamhsa{{/str}}</span>
            </a>
        </nav>
    </div>
</aside>
